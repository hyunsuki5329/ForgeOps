{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/forgeops-context-pack/1.0/schema.json",
  "title": "ForgeOps Untrusted Context Pack Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_pack_version",
    "snapshot_id",
    "query_tokens",
    "items",
    "summary",
    "control_claims_accepted"
  ],
  "properties": {
    "context_pack_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "query_tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size",
          "media_type",
          "selection_reason",
          "score",
          "excerpt",
          "trust"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 200},
          "selection_reason": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["PATH_EXACT", "PATH_SUBSTRING", "CONTENT_MATCH"]}
          },
          "score": {"type": "integer", "minimum": 0},
          "excerpt": {"type": "string", "maxLength": 1024},
          "trust": {"const": "UNTRUSTED_SOURCE"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "excluded_binary", "excluded_oversized"],
      "properties": {
        "selected": {"type": "integer", "minimum": 0},
        "excluded_binary": {"type": "integer", "minimum": 0},
        "excluded_oversized": {"type": "integer", "minimum": 0}
      }
    },
    "control_claims_accepted": {"const": false}
  }
}
