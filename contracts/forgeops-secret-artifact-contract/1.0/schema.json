{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeops:secret-artifact-contract:1.0",
  "title": "ForgeOps Secret Surface and Artifact Contract Fixture 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "suite_version", "surface_cases", "artifact_cases"],
  "properties": {
    "suite_id": {"const": "forgeops-secret-artifact-security-v1"},
    "suite_version": {"const": "1.0"},
    "surface_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/SurfaceCase"}
    },
    "artifact_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ArtifactCase"}
    }
  },
  "$defs": {
    "Effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_calls", "export_calls", "publish_calls", "raw_occurrences"],
      "properties": {
        "store_calls": {"type": "integer", "minimum": 0},
        "export_calls": {"type": "integer", "minimum": 0},
        "publish_calls": {"type": "integer", "minimum": 0},
        "raw_occurrences": {"type": "integer", "minimum": 0}
      }
    },
    "SurfaceInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string"},
        "credential": {"type": "string"},
        "raw_preview": {"type": "string"},
        "private_id": {"type": "string"},
        "secret": {"type": "string"},
        "token": {"type": "string"},
        "content": {"$ref": "#/$defs/UnredactableContent"}
      }
    },
    "SafeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string"},
        "redacted": {"type": "boolean"}
      }
    },
    "SurfaceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "surface", "input", "expected", "expected_effects"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/CaseKind"},
        "surface": {"enum": ["packet", "event", "prompt", "artifact", "trace", "telemetry", "response"]},
        "input": {"$ref": "#/$defs/SurfaceInput"},
        "expected": {"enum": ["PASSED", "SECRET_SURFACE_LEAK", "REDACTION_UNSUPPORTED"]},
        "expected_effects": {"$ref": "#/$defs/Effects"}
      }
    },
    "ArtifactMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "tenant_id",
        "source_ref",
        "checksum_sha256",
        "encryption_state",
        "retention_class",
        "deletion_policy",
        "tamper_ref"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
        "tenant_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
        "source_ref": {"$ref": "#/$defs/SourceRef"},
        "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "encryption_state": {"enum": ["ENCRYPTED", "PUBLIC_SAFE"]},
        "retention_class": {"enum": ["EPHEMERAL", "AUDIT_SHORT", "PUBLIC"]},
        "deletion_policy": {"enum": ["DELETE_ON_TERMINAL", "DELETE_AFTER_RETENTION", "RETAIN_PUBLIC"]},
        "tamper_ref": {"type": "string", "pattern": "^forgeops:tamper:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    },
    "ArtifactCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "artifact", "expected_context", "expected", "expected_effects"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/CaseKind"},
        "artifact": {"$ref": "#/$defs/ArtifactFixtureInput"},
        "expected_context": {"$ref": "#/$defs/ExpectedContext"},
        "expected": {"enum": ["PASSED", "ARTIFACT_TENANT_VIOLATION", "ARTIFACT_REFERENCE_INVALID", "ARTIFACT_POLICY_INVALID"]},
        "expected_effects": {"$ref": "#/$defs/Effects"}
      }
    },
    "ExpectedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id"],
      "properties": {
        "tenant_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"}
      }
    },
    "UnredactableContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsupported"],
      "properties": {
        "unsupported": {"type": "string"}
      }
    },
    "ArtifactFixtureInput": {
      "description": "Closed fixture envelope; ArtifactMetadata separately validates the intentionally malformed negative records.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "tenant_id",
        "source_ref",
        "checksum_sha256",
        "encryption_state",
        "retention_class",
        "deletion_policy",
        "tamper_ref"
      ],
      "properties": {
        "artifact_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "source_ref": {"type": "string"},
        "checksum_sha256": {"type": "string"},
        "encryption_state": {"type": "string"},
        "retention_class": {"type": "string"},
        "deletion_policy": {"type": "string"},
        "tamper_ref": {"type": "string"},
        "unapproved_field": {"type": "string"}
      }
    },
    "CaseKind": {
      "type": "string",
      "enum": ["positive", "negative"]
    },
    "SourceRef": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[?#@])(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
        },
        {
          "type": "string",
          "pattern": "^forgeops:artifact:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      ]
    }
  }
}
