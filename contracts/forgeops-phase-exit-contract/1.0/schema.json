{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/forgeops-phase-exit-contract/1.0/schema.json",
  "title": "ForgeOps Phase 0 exit registry and decision contract",
  "oneOf": [
    {"$ref": "#/$defs/registry"},
    {"$ref": "#/$defs/decision"}
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*]).+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "profile_id", "command_id", "artifact_ref", "required_tier", "input_refs", "hash_fields"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^VG-(?:00[1-9]|023)$"},
        "profile_id": {"type": "string", "pattern": "^forgeops-[a-z0-9-]+$"},
        "command_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "artifact_ref": {"$ref": "#/$defs/path"},
        "required_tier": {"enum": ["E0", "E1", "E2", "E3"]},
        "input_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "hash_fields": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(?![A-Za-z]:[\\\\/])(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*]).+$": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
            }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "suite_version", "phase_id", "freshness_seconds", "registrations"],
      "properties": {
        "suite_id": {"const": "forgeops-phase-0-exit-v1"},
        "suite_version": {"const": "1.0"},
        "phase_id": {"const": "phase-0"},
        "freshness_seconds": {"const": 300},
        "registrations": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/registration"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "failed", "not_run", "blocked"],
      "properties": {
        "required": {"const": 18},
        "passed": {"type": "integer", "minimum": 0, "maximum": 18},
        "failed": {"type": "integer", "minimum": 0, "maximum": 18},
        "not_run": {"type": "integer", "minimum": 0, "maximum": 18},
        "blocked": {"type": "integer", "minimum": 0, "maximum": 18}
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "profile_id", "command_id", "artifact_ref", "required_tier", "status", "observed_at", "input_hashes_valid", "public_safe"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^VG-(?:00[1-9]|023)$"},
        "profile_id": {"type": "string", "pattern": "^forgeops-[a-z0-9-]+$"},
        "command_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "artifact_ref": {"$ref": "#/$defs/path"},
        "required_tier": {"enum": ["E0", "E1", "E2", "E3"]},
        "status": {"enum": ["PASSED", "FAILED", "NOT_RUN"]},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "input_hashes_valid": {"type": "boolean"},
        "public_safe": {"type": "boolean"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "command_id", "reason_code"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^VG-(?:00[1-9]|023)$"},
        "command_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "reason_code": {"type": "string", "pattern": "^PHASE_EXIT_[A-Z0-9_]+$"}
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_coverage", "freshness_valid", "input_hashes_valid", "public_safe", "tiers_sufficient"],
      "properties": {
        "exact_coverage": {"type": "boolean"},
        "freshness_valid": {"type": "boolean"},
        "input_hashes_valid": {"type": "boolean"},
        "public_safe": {"type": "boolean"},
        "tiers_sufficient": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase_id", "status", "observed_at", "registry_sha256", "summary", "gate_results", "blockers", "assertions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "phase_id": {"const": "phase-0"},
        "status": {"enum": ["READY", "NOT_READY"]},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "summary": {"$ref": "#/$defs/summary"},
        "gate_results": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate_result"}
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/blocker"}
        },
        "assertions": {"$ref": "#/$defs/assertions"}
      }
    }
  }
}
